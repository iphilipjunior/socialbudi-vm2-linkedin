NODE_ENV=production
PORT=3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
VM2_DOMAIN=https://socialbudi-li.int.yt
CHROMIUM_PATH=/snap/bin/chromium

# Bright Data residential proxy (used for all LinkedIn scraping)
BRIGHTDATA_PROXY_HOST=brd.superproxy.io
BRIGHTDATA_PROXY_PORT=33335
BRIGHTDATA_PROXY_USERNAME=your-brightdata-proxy-username
BRIGHTDATA_PROXY_PASSWORD=your-brightdata-proxy-password

# DEPRECATED — Bright Data Browser API (WebSocket/CDP) is no longer used
# BRIGHTDATA_WS_ENDPOINT=wss://...
# USE_BRIGHTDATA=true
