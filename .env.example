NODE_ENV=production
PORT=3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
VM2_DOMAIN=https://socialbudi-li.int.yt
CHROMIUM_PATH=/snap/bin/chromium

# Decodo (formerly Smartproxy) residential proxy
DECODO_PROXY_HOST=gate.decodo.com
DECODO_PROXY_PORT=10001
DECODO_PROXY_USER=your-decodo-username
DECODO_PROXY_PASS=your-decodo-password

# Decodo SOCKS5 proxy (used for Puppeteer — avoids TLS fingerprint detection)
DECODO_SOCKS5_USER=user-your-username-session-1
DECODO_SOCKS5_PASS=your-decodo-password

# DEPRECATED — Bright Data Browser API (WebSocket/CDP) is no longer used
# BRIGHTDATA_WS_ENDPOINT=wss://...
# USE_BRIGHTDATA=true
